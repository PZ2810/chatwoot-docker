# Learn about the various environment variables at
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables/#rails-production-variables

# Used to verify the integrity of signed cookies. so ensure a secure value is set
# SECRET_KEY_BASE should be alphanumeric. Avoid special characters or symbols.
# Use `rake secret` to generate this variable
SECRET_KEY_BASE=replace_with_a_64_char_hex_string

# Replace with the URL you are planning to use for your app
FRONTEND_URL=https://your-domain.com

# If you plan to use CDN for your assets, set Asset CDN Host
ASSET_CDN_HOST=

# Force all access to the app over SSL, default is set to false
FORCE_SSL=false

# This lets you control new sign ups on your chatwoot installation
ENABLE_ACCOUNT_SIGNUP=false

# Redis config
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_a_secure_redis_password
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER_NAME=

# Postgres Database config variables
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
RAILS_ENV=production
RAILS_MAX_THREADS=5

# The email from which all outgoing emails are sent
MAILER_SENDER_EMAIL=Chatwoot <accounts@yourdomain.com>

# SMTP Configuration
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Mail Incoming
MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=

# Storage (local or s3)
ACTIVE_STORAGE_SERVICE=local
VIPS_BLOCK_UNTRUSTED=1

# Amazon S3 (if ACTIVE_STORAGE_SERVICE=s3)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Log settings
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500

# Facebook
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=

# Instagram
IG_VERIFY_TOKEN=

# Twitter
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ENVIRONMENT=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=

# Mobile app
IOS_APP_ID=L7YLMN4634.com.chatwoot.app
ANDROID_BUNDLE_ID=com.chatwoot.app
ANDROID_SHA256_CERT_FINGERPRINT=AC:73:8E:DE:EB:56:EA:CC:10:87:02:A7:65:37:7B:38:D4:5D:D4:53:F8:3B:FB:D3:C6:28:64:1D:AA:08:1E:D8

# Push Notifications
ENABLE_PUSH_RELAY_SERVER=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DIRECT_UPLOADS_ENABLED=

# Microsoft OAuth
AZURE_APP_ID=
AZURE_APP_SECRET=
